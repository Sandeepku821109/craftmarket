PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Contact-form messages go here; if unset, they go to SMTP_USER.
CONTACT_EMAIL=
# Optional shared parent domain for cross-subdomain cookies (for example .example.com).
# Leave empty for localhost/host-only cookies. Keep each variable on its own line.
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
# In production, set CORS_ORIGINS to comma-separated HTTPS origins and use
# separate random JWT secrets of at least 32 characters each.
REDIS_URL=rediss://default:<password>@<your-upstash-host>:6379
RABBITMQ_URL=amqps://<user>:<password>@<your-cloudamqp-host>/<vhost>
